# Reachmark Webhosting
# PostgreSQL connection used by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/reachmark"

# Public application URL.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# GitHub OAuth will be wired in the control plane phase.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Encryption key for environment-variable secrets.
# Generate a high-entropy value before enabling secret storage.
SECRETS_ENCRYPTION_KEY=""
