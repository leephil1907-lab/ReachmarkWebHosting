# Reachmark Webhosting
# For local development, run: docker compose up -d
DATABASE_URL="postgresql://reachmark:local-development-only@localhost:5432/reachmark"

# Set to the deployed origin in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Create a GitHub OAuth App with callback:
# http://localhost:3000/api/integrations/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# 32-byte key encoded as 64 hexadecimal characters.
# Generate with: openssl rand -hex 32
# Required for encrypting GitHub tokens and environment variable values.
SECRETS_ENCRYPTION_KEY=""

# Optional dedicated runtime host / Traefik worker configuration.
# For the Compose network, use postgres as the host:
# WORKER_DATABASE_URL="postgresql://reachmark:YOUR_PASSWORD@postgres:5432/reachmark?schema=public"
WORKER_DATABASE_URL=""
DEPLOYMENT_BASE_DOMAIN=""
ACME_EMAIL=""
